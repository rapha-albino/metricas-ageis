---
import { marked } from "marked";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import source from "../../../content/metricas/metricas-de-entrega-accelerate.md?raw";

const title = "O que o Accelerate acrescenta às métricas de fluxo";
const description = "Frequência de implantação, lead time for changes, tempo de restauração e taxa de falha de mudança em diálogo com o fluxo de trabalho.";
const wordCount = (source.match(/[\p{L}\p{N}]+(?:['’-][\p{L}\p{N}]+)*/gu) ?? []).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 220));
const articleHtml = await marked.parse(source);
---
<ArticleLayout title={title} description={description} readingTime={`${readingMinutes} min de leitura`}>
  <Fragment set:html={articleHtml} />
</ArticleLayout>
