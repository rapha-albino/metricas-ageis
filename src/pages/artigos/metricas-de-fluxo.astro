---
import { marked } from "marked";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import source from "../../content/artigos/metricas-de-fluxo.md?raw";

const title = "Métricas de fluxo: medir para enxergar o sistema, não para cobrar pessoas";
const description = "WIP, throughput e lead time como linguagem para melhorar o sistema de trabalho, não para vigiar pessoas.";
const wordCount = (source.match(/[\p{L}\p{N}]+(?:['’-][\p{L}\p{N}]+)*/gu) ?? []).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 220));
const articleHtml = await marked.parse(source);
---
<ArticleLayout title={title} description={description} readingTime={`${readingMinutes} min de leitura`}>
  <Fragment set:html={articleHtml} />
</ArticleLayout>
